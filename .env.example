# AI provider for the "AI Assistant" tab (cloud, no local install needed).
# Pick a FREE Chinese LLM provider and paste its API key.
AI_PROVIDER=qwen            # one of: qwen | deepseek | kimi | siliconflow | openai
AI_API_KEY=                 # your FREE Qwen key from below

# Where to get a FREE key:
#   qwen       -> https://dashscope.console.aliyun.com  (free monthly quota)  [DEFAULT]
#   deepseek   -> https://platform.deepseek.com  (free trial credits)
#   kimi       -> https://platform.moonshot.cn  (free tier)
#   siliconflow-> https://siliconflow.cn  (free quota, many models)

# Where to get a FREE key:
#   deepseek   -> https://platform.deepseek.com  (free trial credits)
#   qwen       -> https://dashscope.console.aliyun.com  (free monthly quota)
#   kimi       -> https://platform.moonshot.cn  (free tier)
#   siliconflow-> https://siliconflow.cn  (free quota, many models)
#
# Optional overrides:
# AI_MODEL=deepseek-chat        # model name (defaults per provider above)
# OPENAI_API_KEY=               # also accepted instead of AI_API_KEY
